            "alter": {
              "alter_text": true,
              "text": "<!-- Featured articles grid -->\r\n<section class=\"py-12 px-4 max-w-7xl mx-auto\">\r\n  \r\n  <!-- Section heading -->\r\n  <div class=\"flex items-center justify-between mb-8\">\r\n    <div>\r\n      <h2 class=\"text-2xl md:text-3xl font-bold text-slate-100 tracking-tight\">Featured Articles</h2>\r\n      <p class=\"text-sm text-slate-400 mt-1\">Thoughts, tutorials, and insights about web development.</p>\r\n    </div>\r\n    <a href=\"/articles\" class=\"inline-flex items-center gap-2 text-sm text-sky-400 hover:text-sky-300 font-medium transition-colors\">\r\n      <span>View All</span>\r\n      <svg class=\"w-4 h-4 rtl:rotate-180\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M17 8l4 4m0 0l-4 4m4-4H3\"/></svg>\r\n    </a>\r\n  </div>\r\n\r\n  <!-- Cards grid -->\r\n  <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\r\n    \r\n    <!-- Article card -->\r\n    <article class=\"group relative bg-[#091b24]/60 backdrop-blur-md rounded-2xl border border-slate-800/80 hover:border-sky-500/50 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-sky-500/10 flex flex-col overflow-hidden\">\r\n      \r\n      <!-- Image with a subtle hover zoom -->\r\n      <div class=\"relative aspect-video w-full overflow-hidden bg-slate-900\">\r\n        <img src=\"[field_image]\" alt=\"[title]\" class=\"w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500 ease-out\" />\r\n        \r\n        <!-- Subtle image gradient overlay -->\r\n        <div class=\"absolute inset-0 bg-gradient-to-t from-[#091b24] via-transparent to-transparent opacity-80\"></div>\r\n        \r\n        <!-- Category badge -->\r\n        <span class=\"absolute top-3 right-3 text-xs font-semibold px-2.5 py-1 rounded-full bg-sky-950/80 text-sky-300 border border-sky-500/30 backdrop-blur-md\">\r\n          [field_taxonomy]\r\n        </span>\r\n      </div>\r\n\r\n      <!-- Card content -->\r\n      <div class=\"p-5 flex-1 flex flex-col justify-between\">\r\n        <div>\r\n          <h3 class=\"text-lg font-bold text-slate-100 group-hover:text-sky-400 transition-colors line-clamp-1\">\r\n            [title]\r\n          </h3>\r\n          <p class=\"mt-2 text-sm text-slate-400 line-clamp-2 leading-relaxed\">\r\n            [field_body]\r\n          </p>\r\n        </div>\r\n\r\n        <!-- Article details link -->\r\n        <div class=\"mt-5 pt-4 border-t border-slate-800/60 flex items-center justify-between text-xs text-slate-400\">\r\n          <span class=\"inline-flex items-center gap-1.5 text-sky-400 group-hover:underline font-medium\">\r\n            Read Article\r\n            <svg class=\"w-3.5 h-3.5 rtl:rotate-180\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"/></svg>\r\n          </span>\r\n          \r\n          <!-- Full-card link -->\r\n          <a href=\"[node_url]\" class=\"absolute inset-0 z-10 font-0\" aria-label=\"[title]\">[title]</a>\r\n        </div>\r\n      </div>\r\n\r\n    </article>\r\n\r\n  </div>\r\n</section>",
